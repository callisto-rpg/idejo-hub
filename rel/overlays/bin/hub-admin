#!/bin/sh
# SPDX-FileCopyrightText: 2026 Mariano Pictet and contributors
# SPDX-License-Identifier: AGPL-3.0-only
#
# Idejo Hub's command line, inside the Hub's container:
#   docker compose -f deploy/docker-compose.yml exec hub bin/hub-admin create-operator EMAIL
set -eu
cd -P -- "$(dirname -- "$0")"

usage() {
  cat <<USAGE
Usage: bin/hub-admin COMMAND

  create-operator EMAIL [--role owner|operator]
                           make a Hub operator; prints their one-time password (SC-08).
                           Without --role: the first account is an owner, later ones
                           operators (HA-07); owners also manage accounts in the Hub
  reset-two-factor EMAIL   remove an operator's two-factor setup and end their sessions

  Forums (HA-08), with the Hub running; each waits for the action to end and exits 0 when
  done, 1 when it failed, 2 for an unknown forum:
  forums                                  list forums: subdomain, status, version, health
  create SUBDOMAIN NAME OWNER_EMAIL       create a forum (the owner is emailed their link)
  backup SUBDOMAIN                        back a running forum up
  upgrade SUBDOMAIN VERSION               upgrade it (backed up first, rolled back if unhealthy)
  suspend SUBDOMAIN                       suspend it (its page says it is paused)
  resume SUBDOMAIN                        resume a suspended forum
USAGE
}

case "${1:-}" in
  create-operator)
    if [ $# -eq 2 ]; then role=""
    elif [ $# -eq 4 ] && [ "$3" = "--role" ] && { [ "$4" = owner ] || [ "$4" = operator ]; }; then role=$4
    else usage >&2; exit 64; fi
    # The email and role go through environment variables, never into the Elixir code.
    HUB_ADMIN_EMAIL="$2" HUB_ADMIN_ROLE="$role" exec ./idejo_hub eval \
      'IdejoHub.Release.create_operator(System.fetch_env!("HUB_ADMIN_EMAIL"), System.fetch_env!("HUB_ADMIN_ROLE"))'
    ;;
  reset-two-factor)
    if [ $# -ne 2 ]; then usage >&2; exit 64; fi
    fun=$(printf '%s' "$1" | tr '-' '_')
    # The email goes through an environment variable, never into the Elixir code.
    HUB_ADMIN_EMAIL="$2" exec ./idejo_hub eval "IdejoHub.Release.$fun(System.fetch_env!(\"HUB_ADMIN_EMAIL\"))"
    ;;
  forums | create | backup | upgrade | suspend | resume)
    case "$1:$#" in
      forums:1 | backup:2 | suspend:2 | resume:2 | upgrade:3 | create:4) ;;
      *) usage >&2; exit 64 ;;
    esac
    ./idejo_hub pid >/dev/null 2>&1 || { echo "The Hub is not running: start it first." >&2; exit 1; }
    cmd=$1; shift
    # Runs inside the Hub (rpc), so each argument travels Base64-encoded: never Elixir code.
    list=""
    for arg in "$@"; do
      list="$list${list:+, }Base.decode64!(\"$(printf '%s' "$arg" | base64 | tr -d '\n')\")"
    done
    exec ./idejo_hub rpc "IdejoHub.Release.cli(\"$cmd\", [$list])"
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac
