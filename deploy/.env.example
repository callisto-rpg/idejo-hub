#
# Copy to deploy/.env and fill in. Never commit deploy/.env.

# The Hub's own host name, for example hub.example.org (no default: LB-05).
IDEJO_HUB_DOMAIN=
# Forums get <subdomain>.IDEJO_FORUM_DOMAIN, for example forums.example.org (no default: LB-05).
# Its wildcard DNS record points to this server (HN-01).
IDEJO_FORUM_DOMAIN=
# Optional: the Idejo version new forums start on (default 0.2.9).
IDEJO_DEFAULT_VERSION=
# ID-01: the identity provider's address (Zitadel), for example id.example.org. Its DNS
# record points to this server. deploy/install.sh asks (--id-domain), id.<IDEJO_HUB_DOMAIN> by
# default. Never change it after the first start: Zitadel keeps the address it started with.
IDEJO_ID_DOMAIN=
# Email for Let's Encrypt notices (also Zitadel's first admin's email).
ACME_EMAIL=

# Generate with: openssl rand -base64 48
SECRET_KEY_BASE=
# SC-04: encrypts every forum's secrets (database password, SECRET_KEY_BASE) in the Hub
# database. Generate with: openssl rand -base64 32
# Keep a copy somewhere safe, apart from the server: without it, the Hub cannot recreate
# forum containers (upgrades, restores). Never change it once forums exist.
HUB_SECRETS_KEY=
# ID-01: Zitadel's secrets. ZITADEL_MASTERKEY must be exactly 32 characters (openssl rand -hex
# 16) and never change: it encrypts Zitadel's data. ZITADEL_ADMIN_PASSWORD is the password of
# Zitadel's first admin ("admin", in the console at https://IDEJO_ID_DOMAIN/ui/console).
ZITADEL_MASTERKEY=
ZITADEL_DB_PASSWORD=
ZITADEL_ADMIN_PASSWORD=
# PostgreSQL superuser, used only to create the Hub's role on first start.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# The Hub's own role (CREATEDB, CREATEROLE, never superuser).
# Generate with: openssl rand -hex 24
HUB_DB_PASSWORD=

# Optional: database connections in the Hub's pool (default 10).
POOL_SIZE=

# HN-04: the group that owns the Docker socket on this host, for socket-proxy.
# Find it with: getent group docker | cut -d: -f3   (or: stat -c %g /var/run/docker.sock)
DOCKER_GID=
# Optional: the Idejo image forums run (default ghcr.io/callisto-rpg/idejo).
IDEJO_FORUM_IMAGE=

# HN-07: optional SMTP server every forum sends through (as IDEJO_SMTP_* in each forum). Each
# forum sends as its own name from the same sender as the Hub, HUB_SMTP_FROM (empty:
# noreply@IDEJO_HUB_DOMAIN), unless given another address when created; its owner can set the forum's own SMTP in its Admin → Email, which wins over this.
# Without it, owners' invites (FL-02) are kept for the operator to pass on.
# Security: starttls, tls or none (default: tls on port 465, else starttls).
HUB_SMTP_HOST=
HUB_SMTP_PORT=
HUB_SMTP_SECURITY=
HUB_SMTP_USERNAME=
HUB_SMTP_PASSWORD=
HUB_SMTP_FROM=

# OP-01: when every running forum is backed up (cron syntax, UTC; default 02:00 daily), and
# how many backups the Hub keeps per forum (default 14) in its exports volume.
IDEJO_HUB_BACKUP_CRON=
IDEJO_HUB_BACKUPS_KEPT=

# OP-02: off-server copies of every backup (forums, the Hub's database, Zitadel's) on
# S3-compatible storage, encrypted with age before upload. Off while IDEJO_HUB_S3_BUCKET is
# empty. Make the key pair on your own computer, not on this server:
#   age-keygen -o idejo-backups.key      (prints "Public key: age1...")
# and put only the public key here. Keep idejo-backups.key safe: without it no copy can be
# read, and the Hub never has it. The keys below need to list, put and delete objects in
# the bucket (the Hub keeps the newest IDEJO_HUB_BACKUPS_KEPT copies of each).
# Endpoint, for example https://s3.eu-central-1.amazonaws.com; requests are path-style.
IDEJO_HUB_S3_ENDPOINT=
IDEJO_HUB_S3_REGION=
IDEJO_HUB_S3_BUCKET=
# Optional folder in the bucket, for example idejo-hub/
IDEJO_HUB_S3_PREFIX=
IDEJO_HUB_S3_ACCESS_KEY_ID=
IDEJO_HUB_S3_SECRET_ACCESS_KEY=
IDEJO_HUB_BACKUP_AGE_RECIPIENT=

# OP-04: seconds an upgraded forum has to answer /health (after its migrations) before the
# Hub rolls it back to its previous version and pre-upgrade backup (default 300).
IDEJO_HUB_UPGRADE_HEALTH_SECONDS=

# FL-07: the largest standalone Idejo backup the "Import a standalone backup" form takes, in
# MB (default 4096). While importing, the server needs about twice the file's size free.
IDEJO_HUB_IMPORT_MAX_MB=

# OP-09: once a day the Hub reads Idejo's published versions from GitHub (no credentials,
# nothing about this Hub sent) to show new releases with a link to what changed. Uncomment
# and leave empty to turn it off, or point both at a mirror.
# IDEJO_HUB_RELEASES_URL=
# IDEJO_HUB_CHANGELOG_URL=https://github.com/callisto-rpg/Idejo/compare/v{from}...v{to}
