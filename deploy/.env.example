#
# Copy to deploy/.env and fill in. Never commit deploy/.env.

# The Hub's own host name, for example hub.example.org (no default: LB-05).
IDEJO_HUB_DOMAIN=
# Forums get <subdomain>.IDEJO_FORUM_DOMAIN, for example forums.example.org (no default: LB-05).
# Its wildcard DNS record points to this server (HN-01).
IDEJO_FORUM_DOMAIN=
# Optional: the Idejo version new forums start on (default 0.1.0).
IDEJO_DEFAULT_VERSION=
# Email for Let's Encrypt notices.
ACME_EMAIL=

# Generate with: openssl rand -base64 48
SECRET_KEY_BASE=
# SC-04: encrypts every forum's secrets (database password, SECRET_KEY_BASE) in the Hub
# database. Generate with: openssl rand -base64 32
# Keep a copy somewhere safe, apart from the server: without it, the Hub cannot recreate
# forum containers (upgrades, restores). Never change it once forums exist.
HUB_SECRETS_KEY=
# PostgreSQL superuser, used only to create the Hub's role on first start.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# The Hub's own role (CREATEDB, CREATEROLE, never superuser).
# Generate with: openssl rand -hex 24
HUB_DB_PASSWORD=

# Optional: database connections in the Hub's pool (default 10).
POOL_SIZE=

# HN-04: the group that owns the Docker socket on this host, for socket-proxy.
# Find it with: getent group docker | cut -d: -f3   (or: stat -c %g /var/run/docker.sock)
DOCKER_GID=
# Optional: the Idejo image forums run (default ghcr.io/callisto-rpg/idejo).
IDEJO_FORUM_IMAGE=

# HN-07: optional SMTP server every forum sends through (as IDEJO_SMTP_* in each forum). Each
# forum sends as its own name at noreply@<subdomain>.IDEJO_FORUM_DOMAIN unless given another
# address; its owner can set the forum's own SMTP in its Admin → Email, which wins over this.
# Without it, owners' invites (FL-02) are kept for the operator to pass on.
# Security: starttls, tls or none (default: tls on port 465, else starttls).
HUB_SMTP_HOST=
HUB_SMTP_PORT=
HUB_SMTP_SECURITY=
HUB_SMTP_USERNAME=
HUB_SMTP_PASSWORD=
