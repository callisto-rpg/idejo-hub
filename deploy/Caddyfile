# Automatic HTTPS for the Hub's own host. Forum subdomains, on-demand TLS and the Hub's
# "ask" endpoint come with HN-02 (milestone 2).

{
	email {$ACME_EMAIL}
}

{$IDEJO_HUB_DOMAIN} {
	encode zstd gzip

	tls {
		protocols tls1.2 tls1.3
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy hub:4000
}
