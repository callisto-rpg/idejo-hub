<%!-- Signed out of the members' page, or a sign-in that did not work: a way back in, without
     sending the browser straight back to the sign-in host. --%>
<Layouts.app flash={@flash} title="Idejo">
  <h1 class="text-2xl font-semibold">Your forums, topics and chats</h1>
  <p>
    Sign in with your Idejo ID to see the forums you joined, the topics you follow and your chats.
  </p>
  <a id="my-sign-in" href={~p"/sign-in"} class="btn btn-primary">Sign in</a>
</Layouts.app>
