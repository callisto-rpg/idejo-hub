<Layouts.app flash={@flash} title="idejo ID">
  <p><a href={~p"/account"}>← Your idejo ID</a></p>
  <h1 class="text-2xl font-semibold">Audit log of {@forum.display_name}</h1>
  <p class="text-sm">
    What the Hub and its operator did to <a href={forum_url(@forum)}>{forum_host(@forum)}</a>,
    and when: the newest 200 entries, newest first. Times are UTC. <a href={
      ~p"/account/operator-access"
    }>What the Hub operator can access</a>, and when they would.
  </p>
  <p :if={@entries == []} id="log-empty">No entries yet.</p>
  <table :if={@entries != []} id="log" class="table table-sm">
    <thead>
      <tr>
        <th>When (UTC)</th>
        <th>Who</th>
        <th>What</th>
        <th>Outcome</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      <tr :for={e <- @entries} id={"log-#{e.id}"}>
        <td>
          <time datetime={DateTime.to_iso8601(e.inserted_at)}>
            {Calendar.strftime(e.inserted_at, "%Y-%m-%d %H:%M")}
          </time>
        </td>
        <td>{who(e.actor)}</td>
        <td>{what(e.action)}</td>
        <td>{e.outcome}</td>
        <td class="text-sm break-all">{owner_details(e)}</td>
      </tr>
    </tbody>
  </table>
</Layouts.app>
