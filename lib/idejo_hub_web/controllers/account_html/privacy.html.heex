<%!-- Hub NF-07: the members' privacy notice, as a standalone idejo's /privacy (AD-02). --%>
<Layouts.app flash={@flash} title="idejo ID">
  <h1 class="text-2xl font-semibold">Privacy</h1>
  <div id="privacy-notice" class="space-y-3">
    <p :if={@notice == []} id="privacy-notice-none">
      This Hub has not published a privacy notice yet.
    </p>
    <p :for={paragraph <- @notice} class="whitespace-pre-line">{paragraph}</p>
  </div>
</Layouts.app>
