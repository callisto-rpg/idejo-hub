<Layouts.app flash={@flash} title="Idejo ID">
  <h1 class="text-2xl font-semibold">Your Idejo ID</h1>
  <p>See the forums you have joined, leave any of them, or delete your Idejo ID.</p>
  <p class="flex gap-2">
    <a href={~p"/account/sign-in"} id="account-sign-in" class="btn btn-primary">Sign in</a>
    <a href={~p"/account/sign-up"} class="btn">Create an Idejo ID</a>
  </p>
</Layouts.app>
