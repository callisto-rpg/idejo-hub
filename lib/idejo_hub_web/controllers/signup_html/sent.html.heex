<Layouts.app flash={@flash} title="Idejo ID">
  <h1 class="text-2xl font-semibold">Check your email</h1>
  <p id="signup-sent">
    We sent a link to <strong>{@email}</strong>. Open it to confirm the address and choose a
    password or a passkey; then sign in to any forum on this server with "Idejo ID".
  </p>
</Layouts.app>
