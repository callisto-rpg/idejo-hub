<%!-- The forums directory (steward decisions 2026-11-06): cards with each forum's logo; past
     ten forums, a search and pages. Plain HTML, no JavaScript needed. --%>
<Layouts.app flash={@flash} title="Forums" wide>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-semibold">Forums</h1>
    <a :if={!@signed_in?} id="directory-sign-in" href={~p"/sign-in"} class="btn btn-sm">
      Sign in to see your forums
    </a>
    <form :if={@signed_in?} action={~p"/sign-out"} method="post">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <button id="directory-sign-out" class="btn btn-sm btn-ghost">Sign out</button>
    </form>
  </div>

  <form
    :if={@browse?}
    id="directory-search"
    action={~p"/"}
    method="get"
    role="search"
    class="flex gap-2"
  >
    <label class="grow">
      <span class="sr-only">Search the forums</span>
      <input
        type="search"
        name="q"
        value={@result.search}
        placeholder="Search the forums"
        class="input w-full"
      />
    </label>
    <button class="btn btn-primary">Search</button>
  </form>

  <p :if={@forums == [] and @result.search == ""} id="directory-empty">
    No forums are listed yet.
  </p>
  <p :if={@forums == [] and @result.search != ""} id="directory-none">
    No forum matches “{@result.search}”.
  </p>

  <%!-- The visitor's own forums first (steward request 2026-11-06), then all of them. --%>
  <section :if={@mine != []} id="directory-mine" aria-labelledby="directory-mine-heading">
    <h2 id="directory-mine-heading" class="sr-only">Your forums</h2>
    <ul class="directory-grid">
      <li :for={forum <- @mine}><.forum_card forum={forum} id_prefix="mine" /></li>
    </ul>
  </section>
  <h2 :if={@mine != []} id="directory-all" class="directory-divider">All forums</h2>

  <ul :if={@forums != []} id="directory" class="directory-grid">
    <li :for={forum <- @forums}><.forum_card forum={forum} id_prefix="all" /></li>
  </ul>

  <nav
    :if={@browse? and @result.pages > 1}
    aria-label="Pages"
    id="directory-pages"
    class="flex items-center justify-between gap-2"
  >
    <a
      :if={@result.page > 1}
      href={~p"/?#{page_params(@result, @result.page - 1)}"}
      rel="prev"
      class="btn btn-sm"
    >
      Previous
    </a>
    <span :if={@result.page == 1}></span>
    <span class="text-sm">Page {@result.page} of {@result.pages}</span>
    <a
      :if={@result.page < @result.pages}
      href={~p"/?#{page_params(@result, @result.page + 1)}"}
      rel="next"
      class="btn btn-sm"
    >
      Next
    </a>
    <span :if={@result.page == @result.pages}></span>
  </nav>
</Layouts.app>
