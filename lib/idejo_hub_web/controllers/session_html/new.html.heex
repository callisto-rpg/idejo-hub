<Layouts.app flash={@flash}>
  <h1 class="text-2xl font-semibold">Sign in to idejo Hub</h1>
  <.form for={@form} id="sign-in" action={~p"/sign-in"} method="post">
    <.input field={@form[:email]} type="email" label="Email" autocomplete="username" required />
    <.input
      field={@form[:password]}
      type="password"
      label="Password"
      autocomplete="current-password"
      required
    />
    <.button>Continue</.button>
  </.form>
  <p>
    <.link id="forgot-password" href={~p"/sign-in/reset"} class="btn btn-ghost btn-sm">
      Forgot your password?
    </.link>
    <.link id="lost-two-factor" href={~p"/sign-in/two-factor-reset"} class="btn btn-ghost btn-sm">
      Lost your two-factor app?
    </.link>
  </p>
</Layouts.app>
